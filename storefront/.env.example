# Local prototype. No paid services are provisioned by these placeholders.
# Set true to test the standalone presentation locally. Vercel always uses it.
EDDFA_DEMO_MODE=false
# Optional fixed demo account. Server-only; never put real values in Git.
EDDFA_DEMO_EMAIL=
EDDFA_DEMO_PASSWORD_HASH=
EDDFA_DEMO_SESSION_SECRET=
# Future public Store API credentials; COD checkout is not active.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Server-only commerce API URL. Local prototype expects http://127.0.0.1:9000.
MEDUSA_BACKEND_URL=
# Enable loopback HTTP only when running the local backend prototype.
EDDFA_LOCAL_ADMIN=false
# Local preview credit; obtain Abbess's approval before publishing it.
NEXT_PUBLIC_EDDFA_SHOW_CREDIT=false
